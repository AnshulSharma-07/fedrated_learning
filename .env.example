# Application URL and runtime port
APP_URL="http://localhost:3000"
PORT="3000"

# Security & Authentication (replace in production; never commit real secrets)
FL_IDS_JWT_SECRET="dev-change-this-jwt-secret-min-32-chars"
FL_IDS_PAYLOAD_MASTER_KEY="dev-change-this-32-byte-aes-master-secret"

# Database configuration (SQLite default; PostgreSQL optional for Python backend)
DATABASE_URL="sqlite:///./data/fl_ids.db"

# Local development key storage directory (excluded from git)
FL_IDS_KEY_DIR=".local_keys"

# TLS configuration (optional for production HTTPS / Flower gRPC TLS)
TLS_CERT_PATH=""
TLS_KEY_PATH=""
TLS_CA_PATH=""

# Optional Gemini API key (not required for core ML/FL/IDS pipeline)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
